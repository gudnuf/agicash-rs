# Nix
.direnv/
result
result-*

# pre-commit
# NOTE: .pre-commit-config.yaml is now TRACKED (chore/fast-precommit-hooks).
# It was gitignored during the React->Rust migration when the old devenv
# prek config was deleted; that left every checkout with a no-op prek hook
# bypassed via PREK_ALLOW_NO_CONFIG=1, so unformatted code reached CI. The
# tracked config below restores a fast fmt + hygiene gate. Do NOT re-ignore.

# IDEs and editors
/.idea
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

/.cache
.env
# Runtime artifact written by scripts/cdk-mint-e2e.sh (mint URL export).
/.cdk-mint-e2e.env

.DS_Store

# Claude Code
.claude/settings.local.json
.claude/worktrees/
/.claude/cdk-mintd-install/
/.claude/scheduled_tasks.lock

# Local SSL certificates
/certs/*
!/certs/ci-localhost-cert.pem
!/certs/ci-localhost-key.pem
# Same certs, but the flake's default shell may auto-generate them from
# `cd crates` (mkcert ends up rooted at the workspace root, not repo root).
/crates/certs/

# Breez Spark SDK cache data
.spark-data/

# Rust
/target
/target-devsim
/crates/target
/crates/**/pkg

# Leptos PWA — Tailwind v4 OUTPUT (`style/main.css`). The input file
# `style/tailwind.in.css` IS tracked; the output is regenerated on every
# `aweb` from the input + `src/**/*.rs` class strings. See
# `nix/shells/default.nix#aweb` for the pipeline.
/crates/agicash-web-leptos/style/main.css
# Per-machine cargo cache config (shared CARGO_TARGET_DIR + sccache wrapper).
# Generated locally for cross-worktree build caching; absolute macOS paths
# inside break CI on Linux runners. See feedback_dev_loop_cache memory note.
/crates/.cargo/

# sccache local cache directory (devenv.nix RUSTC_WRAPPER).
/.sccache

# iOS / Swift bindings
/bindings/swift/rust/target
/bindings/swift/build
/bindings/swift/Sources
# dev-sim stamps (xcframework / xcodeproj / .app input-hash markers)
/bindings/swift/.dev-sim
/ios/**/build
/ios/**/*.xcodeproj
/ios/**/DerivedData

# JS / Web app leftovers (from TS-app branches; not tracked on agicash-rs)
node_modules/
/build/
/packages/
/.react-router/
/playwright-report/
/test-results/

# devenv (companion to existing .direnv/)
/.devenv/
.devenv.flake.nix
.devenv.*.nix

# Local dev artifacts
/android/Agicash/app/src/main/res/raw/local_dev_ca.pem
